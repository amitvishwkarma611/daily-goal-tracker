rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // User Profile Rules
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId)
        && incoming().id == userId
        && incoming().email is string
        && incoming().email.size() <= 256
        && (!('displayName' in incoming()) || (incoming().displayName is string && incoming().displayName.size() <= 128))
        && (!('photoURL' in incoming()) || (incoming().photoURL is string && incoming().photoURL.size() <= 512));
      allow update: if isOwner(userId)
        && incoming().id == userId
        && incoming().email == existing().email
        && (!('displayName' in incoming()) || (incoming().displayName is string && incoming().displayName.size() <= 128));
      allow delete: if isOwner(userId);

      // User Goals Subcollection
      match /goals/{goalId} {
        allow read, write: if isOwner(userId);
      }

      // User Tasks Subcollection
      match /tasks/{taskId} {
        allow read, write: if isOwner(userId);
      }

      // User Daily Records Subcollection
      match /records/{dateId} {
        allow read, write: if isOwner(userId);
      }
    }
  }
}
